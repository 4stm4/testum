# ---------------------------------------------------------------------------
# arg parser
# ---------------------------------------------------------------------------

def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="testumctl — CLI for the Testum SSH execution platform",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  testumctl login --url http://localhost:8000
  testumctl platforms list
  testumctl exec <platform-id> "uptime" --wait
  testumctl scripts create --name deploy --content "$(cat deploy.sh)"
  testumctl scripts exec <platform-id> <script-id> --wait
  testumctl automations list
  testumctl automations run <job-id>
  testumctl automations enable <job-id>
  testumctl audit list --limit 20
""",
    )
    sub = parser.add_subparsers(dest="command")

    # -- login --
    lp = sub.add_parser("login", help="Authenticate and save token")
    lp.add_argument("--url", help="Testum base URL")
    lp.add_argument("--username", "-u")
    lp.add_argument("--password", "-p")

    # -- platforms --
    pp = sub.add_parser("platforms", help="Manage SSH platforms")
    psub = pp.add_subparsers(dest="subcommand")

    pl = psub.add_parser("list", help="List platforms")
    pl.add_argument("--limit", type=int, default=100)
    pl.add_argument("--offset", type=int, default=0)
    pl.add_argument("--json", action="store_true")

    pa = psub.add_parser("add", help="Add a platform")
    pa.add_argument("--name", required=True)
    pa.add_argument("--host", required=True)
    pa.add_argument("--port", type=int, default=22)
    pa.add_argument("--username", required=True)
    pa.add_argument("--auth-method", choices=["password", "key"], default="password")
    pa.add_argument("--password")

    prm = psub.add_parser("remove", help="Delete a platform")
    prm.add_argument("platform_id")
    prm.add_argument("--yes", "-y", action="store_true")

    prf = psub.add_parser("refresh", help="Refresh system_info for a platform")
    prf.add_argument("platform_id")
    prf.add_argument("--json", action="store_true")

    # -- exec --
    ep = sub.add_parser("exec", help="Run a shell command on a platform")
    ep.add_argument("platform_id")
    ep.add_argument("command")
    ep.add_argument("--timeout", type=int, default=60)
    ep.add_argument("--wait", action="store_true", help="Wait for completion and show output")

    # -- task --
    tp = sub.add_parser("task", help="Inspect or revoke tasks")
    tsub = tp.add_subparsers(dest="subcommand")

    tg = tsub.add_parser("get", help="Show task details")
    tg.add_argument("task_id")
    tg.add_argument("--json", action="store_true")

    tv = tsub.add_parser("revoke", help="Cancel a running task")
    tv.add_argument("task_id")
    tv.add_argument("--yes", "-y", action="store_true")

    # -- scripts --
    sp = sub.add_parser("scripts", help="Manage scripts")
    ssub = sp.add_subparsers(dest="subcommand")

    sl = ssub.add_parser("list", help="List scripts")
    sl.add_argument("--limit", type=int, default=100)
    sl.add_argument("--offset", type=int, default=0)
    sl.add_argument("--json", action="store_true")

    ss = ssub.add_parser("show", help="Show script content")
    ss.add_argument("script_id")
    ss.add_argument("--json", action="store_true")

    sc = ssub.add_parser("create", help="Create a script")
    sc.add_argument("--name", required=True)
    sc.add_argument("--content", help="Script body (or pipe via stdin)")
    sc.add_argument("--language", default="shell")
    sc.add_argument("--description")

    srm = ssub.add_parser("remove", help="Delete a script")
    srm.add_argument("script_id")
    srm.add_argument("--yes", "-y", action="store_true")

    sx = ssub.add_parser("exec", help="Run a script on a platform")
    sx.add_argument("platform_id")
    sx.add_argument("script_id")
    sx.add_argument("--timeout", type=int, default=60)
    sx.add_argument("--wait", action="store_true")

    # -- automations --
    ap = sub.add_parser("automations", help="Manage automation jobs")
    asub = ap.add_subparsers(dest="subcommand")

    al = asub.add_parser("list", help="List automation jobs")
    al.add_argument("--limit", type=int, default=100)
    al.add_argument("--offset", type=int, default=0)
    al.add_argument("--json", action="store_true")

    aw = asub.add_parser("show", help="Show automation job details")
    aw.add_argument("job_id")
    aw.add_argument("--json", action="store_true")

    ar = asub.add_parser("run", help="Manually dispatch an automation job")
    ar.add_argument("job_id")

    ae = asub.add_parser("enable", help="Enable an automation job")
    ae.add_argument("job_id")

    ad = asub.add_parser("disable", help="Disable an automation job")
    ad.add_argument("job_id")

    adel = asub.add_parser("remove", help="Delete an automation job")
    adel.add_argument("job_id")
    adel.add_argument("--yes", "-y", action="store_true")

    # -- audit --
    aup = sub.add_parser("audit", help="View audit logs")
    ausub = aup.add_subparsers(dest="subcommand")

    aul = ausub.add_parser("list", help="List recent audit events")
    aul.add_argument("--limit", type=int, default=50)
    aul.add_argument("--offset", type=int, default=0)
    aul.add_argument("--action", help="Filter by action name")
    aul.add_argument("--json", action="store_true")

    aus = ausub.add_parser("stats", help="Show audit statistics")
    aus.add_argument("--json", action="store_true")

    return parser, pp, tp, sp, ap, aup


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    parser, platforms_parser, task_parser, scripts_parser, automations_parser, audit_parser = _build_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    config_manager = ConfigManager()

    if args.command == "login":
        cmd_login(args, config_manager)
        return

    config = config_manager.load()
    if not config.get("base_url") or not config.get("token"):
        _die("Not logged in. Run: testumctl login")

    client = TestumClient(config["base_url"], config["token"])

    try:
        if args.command == "platforms":
            sub = getattr(args, "subcommand", None)
            if sub == "list":
                cmd_platforms_list(args, client)
            elif sub == "add":
                cmd_platforms_add(args, client)
            elif sub == "remove":
                cmd_platforms_remove(args, client)
            elif sub == "refresh":
                cmd_platforms_refresh(args, client)
            else:
                platforms_parser.print_help()

        elif args.command == "exec":
            cmd_exec(args, client)

        elif args.command == "task":
            sub = getattr(args, "subcommand", None)
            if sub == "get":
                cmd_task_get(args, client)
            elif sub == "revoke":
                cmd_task_revoke(args, client)
            else:
                task_parser.print_help()

