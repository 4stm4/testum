        result = client.refresh_platform_info(args.platform_id)
        if args.json:
            print(json.dumps(result, indent=2, default=str))
        else:
            info = result.get("system_info", {})
            for key, val in info.items():
                print(f"  {key:<16} {val}")
    except requests.HTTPError as e:
        _die(str(e))


# ---------------------------------------------------------------------------
# exec
# ---------------------------------------------------------------------------

def cmd_exec(args, client: TestumClient):
    try:
        result = client.run_command(args.platform_id, args.command, args.timeout)
        task_id = result.get("task_id")
        if not args.wait:
            print(f"✓ Task started: {task_id}")
            print(f"  Poll: testumctl task get {task_id}")
            return

        print(f"Task {task_id} — waiting…")
        task = _poll_task(client, task_id)
        print()
        print(f"Status : {task.get('status')}")
        if task.get("stdout"):
            print("\nOutput:\n" + task["stdout"])
        if task.get("stderr"):
            print("\nStderr:\n" + task["stderr"])
    except requests.HTTPError as e:
        _die(str(e))


