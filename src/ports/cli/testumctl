        if not sys.stdin.isatty():
            content = sys.stdin.read()
        else:
            _die("Provide --content or pipe content via stdin")

    data = {
        "name": args.name,
        "content": content,
        "language": args.language,
    }
    if args.description:
        data["description"] = args.description

    try:
        s = client.create_script(data)
        print(f"✓ Script created: {s['id']}")
    except requests.HTTPError as e:
        _die(str(e))


