from getpass import getpass
from pathlib import Path
from typing import Optional


# ---------------------------------------------------------------------------
# API client
# ---------------------------------------------------------------------------

class TestumClient:
    def __init__(self, base_url: str, token: Optional[str] = None):
        self.base_url = base_url.rstrip('/')
        self.token = token
        self.session = requests.Session()
        if token:
            self.session.cookies.set('access_token', token)

    def _get(self, path: str, **kwargs) -> requests.Response:
        r = self.session.get(f"{self.base_url}{path}", **kwargs)
        r.raise_for_status()
        return r

    def _post(self, path: str, **kwargs) -> requests.Response:
        r = self.session.post(f"{self.base_url}{path}", **kwargs)
        r.raise_for_status()
        return r

    def _put(self, path: str, **kwargs) -> requests.Response:
        r = self.session.put(f"{self.base_url}{path}", **kwargs)
        r.raise_for_status()
        return r

    def _delete(self, path: str, **kwargs) -> requests.Response:
        r = self.session.delete(f"{self.base_url}{path}", **kwargs)
        r.raise_for_status()
        return r

    # --- auth ---
    def login(self, username: str, password: str) -> str:
        r = self.session.post(
            f"{self.base_url}/api/auth/login",
            json={"username": username, "password": password},
        )
        r.raise_for_status()
        self.token = r.json()["access_token"]
        return self.token

    # --- platforms ---
    def list_platforms(self, limit: int = 100, offset: int = 0) -> list:
        return self._get("/api/platforms/", params={"limit": limit, "offset": offset}).json()

    def get_platform(self, platform_id: str) -> dict:
        return self._get(f"/api/platforms/{platform_id}").json()

    def create_platform(self, data: dict) -> dict:
        return self._post("/api/platforms/", json=data).json()

    def delete_platform(self, platform_id: str) -> None:
        self._delete(f"/api/platforms/{platform_id}")

    def refresh_platform_info(self, platform_id: str) -> dict:
        return self._post(f"/api/platforms/{platform_id}/refresh-info").json()

    # --- tasks ---
    def run_command(self, platform_id: str, command: str, timeout: int = 60) -> dict:
        return self._post(
            f"/api/platforms/{platform_id}/run_command",
            json={"command": command, "timeout": timeout},
        ).json()

    def get_task(self, task_id: str) -> dict:
        return self._get(f"/api/tasks/{task_id}").json()

    def revoke_task(self, task_id: str) -> dict:
        return self._post(f"/api/tasks/{task_id}/revoke").json()

    # --- scripts ---
    def list_scripts(self, limit: int = 100, offset: int = 0) -> list:
        return self._get("/api/scripts/", params={"limit": limit, "offset": offset}).json()

    def get_script(self, script_id: str) -> dict:
        return self._get(f"/api/scripts/{script_id}").json()

    def create_script(self, data: dict) -> dict:
        return self._post("/api/scripts/", json=data).json()

    def delete_script(self, script_id: str) -> None:
        self._delete(f"/api/scripts/{script_id}")

    def run_script(self, platform_id: str, script_id: str, timeout: int = 60) -> dict:
        return self._post(
            f"/api/platforms/{platform_id}/run_command",
            json={"script_id": script_id, "timeout": timeout},
        ).json()

    # --- automations ---
    def list_automations(self, limit: int = 100, offset: int = 0) -> list:
        return self._get("/api/automations/", params={"limit": limit, "offset": offset}).json()

    def get_automation(self, job_id: str) -> dict:
        return self._get(f"/api/automations/{job_id}").json()

    def create_automation(self, data: dict) -> dict:
        return self._post("/api/automations/", json=data).json()

    def update_automation(self, job_id: str, data: dict) -> dict:
        return self._put(f"/api/automations/{job_id}", json=data).json()

    def delete_automation(self, job_id: str) -> None:
        self._delete(f"/api/automations/{job_id}")

    def run_automation(self, job_id: str) -> dict:
        return self._post(f"/api/automations/{job_id}/run").json()

    # --- audit ---
    def list_audit(self, limit: int = 50, offset: int = 0, action: Optional[str] = None) -> list:
        params: dict = {"limit": limit, "offset": offset}
        if action:
            params["action"] = action
        return self._get("/api/audit/", params=params).json()

    def audit_stats(self) -> dict:
        return self._get("/api/audit/stats").json()


# ---------------------------------------------------------------------------
# Config manager
# ---------------------------------------------------------------------------

class ConfigManager:
    def __init__(self):
        self.config_dir = Path.home() / ".testum"
        self.config_file = self.config_dir / "config.json"
        self.config_dir.mkdir(exist_ok=True)

    def load(self) -> dict:
        if self.config_file.exists():
            return json.loads(self.config_file.read_text())
        return {}

    def save(self, config: dict) -> None:
        self.config_file.write_text(json.dumps(config, indent=2))
        self.config_file.chmod(0o600)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _die(msg: str) -> None:
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(1)


def _json_or_table(data, json_flag: bool, render_fn) -> None:
    if json_flag:
        print(json.dumps(data, indent=2, default=str))
    else:
        render_fn(data)


def _poll_task(client: TestumClient, task_id: str, interval: float = 1.5) -> dict:
    """Poll until task leaves PENDING/RUNNING state."""
    while True:
        task = client.get_task(task_id)
        status = task.get("status", "")
        if status not in ("pending", "running"):
            return task
        print(f"  [{status}] …", end="\r", flush=True)
        time.sleep(interval)


# ---------------------------------------------------------------------------
# login
# ---------------------------------------------------------------------------

def cmd_login(args, config_manager: ConfigManager):
    base_url = args.url or input("Testum URL (e.g., http://localhost:8000): ")
    username = args.username or input("Username: ")
    password = args.password or getpass("Password: ")

    client = TestumClient(base_url)
    try:
        token = client.login(username, password)
        config_manager.save({"base_url": base_url, "token": token, "username": username})
        print(f"✓ Logged in as {username}")
    except requests.HTTPError as e:
        _die(f"Login failed: {e}")


