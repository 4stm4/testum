def _render_platforms(platforms: list) -> None:
    print(f"{'ID':<36}  {'Name':<20}  {'Host':<30}  Status")
    print("-" * 96)
    for p in platforms:
        status = "active" if p.get("is_active", True) else "inactive"
        print(f"{p['id']:<36}  {p['name']:<20}  {p['host']:<30}  {status}")


def cmd_platforms_list(args, client: TestumClient):
    try:
        data = client.list_platforms(limit=args.limit, offset=args.offset)
        _json_or_table(data, args.json, _render_platforms)
    except requests.HTTPError as e:
        _die(str(e))


def cmd_platforms_add(args, client: TestumClient):
    data = {
        "name": args.name,
        "host": args.host,
        "port": args.port,
        "username": args.username,
        "auth_method": args.auth_method,
    }
    if args.auth_method == "password":
        data["password"] = args.password or getpass("SSH password: ")
    try:
        p = client.create_platform(data)
        print(f"✓ Platform created: {p['id']}")
    except requests.HTTPError as e:
        _die(str(e))


def cmd_platforms_remove(args, client: TestumClient):
    if not args.yes:
        if input(f"Delete platform {args.platform_id}? [y/N]: ").lower() != "y":
            print("Cancelled")
            return
    try:
        client.delete_platform(args.platform_id)
        print(f"✓ Deleted: {args.platform_id}")
    except requests.HTTPError as e:
        _die(str(e))


def cmd_platforms_refresh(args, client: TestumClient):
