# Place your TLS certificates here:
#   fullchain.pem  — certificate + intermediate chain
#   privkey.pem    — private key (chmod 600)
#
# For Let's Encrypt (certbot):
#   certbot certonly --standalone -d your-domain.example.com
#   cp /etc/letsencrypt/live/your-domain/fullchain.pem ./nginx/certs/
#   cp /etc/letsencrypt/live/your-domain/privkey.pem   ./nginx/certs/
#
# For self-signed (development / LAN):
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout nginx/certs/privkey.pem \
#     -out nginx/certs/fullchain.pem \
#     -subj "/CN=localhost"
