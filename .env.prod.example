# =============================================================================
# Testum — Production Environment Configuration
# =============================================================================
# Copy to .env.prod and fill in real values before starting.
# NEVER commit .env.prod to version control.
#
# Generate FERNET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Generate POSTGRES_PASSWORD:
#   openssl rand -base64 32
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_MIN_32_CHARS
TOKEN_EXPIRY_HOURS=24

# ── Admin account (created on first boot) ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Encryption (required) ────────────────────────────────────────────────────
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=testum
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=testum
DATABASE_URL=postgresql://testum:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/testum
PYJOBKIT_DATABASE_URL=postgresql+asyncpg://testum:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/testum

# ── MinIO S3 ─────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=testum-artifacts
MINIO_SECURE=false

# ── CORS (comma-separated origins, or * for dev only) ───────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ── SSH ──────────────────────────────────────────────────────────────────────
# auto_add = TOFU (dev). strict = reject unknown hosts (prod recommended)
SSH_HOST_KEY_POLICY=auto_add

# ── SMTP (optional) ──────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notify@example.com
# SMTP_PASSWORD=REPLACE
# SMTP_FROM=testum@example.com
# SMTP_TLS=true

# ── Nervum SDN (optional) ────────────────────────────────────────────────────
# NERVUM_URL=http://nervum:8080
# NERVUM_CALLBACK_URL=https://your-domain.example.com/webhooks/nervum
# NERVUM_TOKEN=REPLACE
# NERVUM_WEBHOOK_SECRET=REPLACE
# NERVUM_BOOTSTRAP_TOKEN=REPLACE
