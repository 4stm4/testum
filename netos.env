# ─────────────────────────────────────────────────────────────────────────────
# Testum — NetOS WebUI integration manifest
# Source: https://github.com/4stm4/testum
# ─────────────────────────────────────────────────────────────────────────────

# ── Source ────────────────────────────────────────────────────────────────────
NETOS_WEBUI_GIT_URL=https://github.com/4stm4/testum.git
NETOS_WEBUI_GIT_BRANCH=main
NETOS_WEBUI_INSTALL_URL=https://raw.githubusercontent.com/4stm4/testum/main/install.sh

# ── Runtime (no Docker, no systemd required) ──────────────────────────────────
# Python requirements file (relative to repo root):
NETOS_WEBUI_REQUIREMENTS=requirements.txt

# ASGI app module:
NETOS_WEBUI_APP_MODULE=app.main:app

# PYTHONPATH must include src/:
NETOS_WEBUI_PYTHONPATH=src

# Start command — $TESTUM_PORT is substituted by NetOS:
NETOS_WEBUI_START_CMD='python3 -m uvicorn app.main:app --host 0.0.0.0 --port ${TESTUM_PORT:-8080}'

# ── Migrations (Alembic) ──────────────────────────────────────────────────────
NETOS_WEBUI_MIGRATE_CMD='python3 -m alembic upgrade head'

# ── Health endpoint ───────────────────────────────────────────────────────────
# Returns 200 OK with JSON {"status":"ok"} when the app is ready:
NETOS_WEBUI_HEALTH_PATH=/health

# ── Required environment variables ───────────────────────────────────────────
# NetOS must supply these before starting (generate once, persist across reboots):
#
#   SECRET_KEY          — random string, JWT signing key
#   FERNET_KEY          — Fernet 32-byte base64 key (for encrypting SSH credentials)
#                         generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   ADMIN_USERNAME      — initial admin login (default: admin)
#   ADMIN_PASSWORD      — initial admin password
#   DATABASE_URL        — SQLite or PostgreSQL
#                         SQLite (single-node): sqlite:////opt/testum/testum.db
#                         PostgreSQL:           postgresql://user:pass@host:5432/testum
#   TESTUM_PORT         — HTTP port (passed into START_CMD)
#
# Optional:
#   SSH_HOST_KEY_POLICY — auto_add (default) | strict
#   MINIO_ENDPOINT      — artifact storage (skip for minimal install)
#   APP_ENV             — development | production (default: production)

# ── Frontend assets ───────────────────────────────────────────────────────────
# No build step required.
# All static assets (CSS/JS) are pre-built and committed under:
#   src/ports/web/static/
# No Node.js, no npm, no webpack needed.

# ── Minimal quick-start for NetOS scripts ────────────────────────────────────
# 1. Clone:
#      git clone --depth 1 https://github.com/4stm4/testum.git /opt/testum
#
# 2. Install deps:
#      cd /opt/testum
#      python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
#
# 3. Export env:
#      export PYTHONPATH=/opt/testum/src
#      export DATABASE_URL=sqlite:////opt/testum/testum.db
#      export FERNET_KEY=$(python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
#      export SECRET_KEY=$(openssl rand -base64 32)
#      export ADMIN_PASSWORD=changeme
#
# 4. Migrate:
#      cd /opt/testum && .venv/bin/alembic upgrade head
#
# 5. Start:
#      .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
#
# 6. Smoke-test:
#      curl -sf http://127.0.0.1:8080/health && echo OK
